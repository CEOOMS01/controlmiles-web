# Public/client-safe values only. NEVER put a service_role key in a
# NEXT_PUBLIC_* variable -- anything prefixed NEXT_PUBLIC_ ships to the
# browser bundle. Server-only secrets (if this project ever needs one)
# go in a non-prefixed var and are read only inside Route Handlers /
# Server Actions, never imported by client components.
NEXT_PUBLIC_SUPABASE_URL=https://zuujwmcftycmdaxesdya.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Server-only secret pepper for hashing requester IPs before they reach
# Postgres. Generate a fresh one per environment (never reuse this
# example value): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_PEPPER=replace-with-a-real-random-64-char-hex-value
